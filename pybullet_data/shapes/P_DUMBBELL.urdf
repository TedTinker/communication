
<?xml version="1.0"?>
<robot name="shape">
    <!-- Definition of the base -->

    <link name="base">
        <visual>
            <geometry>
                <cylinder length=".1" radius="0.6"/>
            </geometry>
            <material name="base_material">
                <color rgba="1 1 1 1"/> 
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder length=".1" radius="0.6"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0"/> 
            <mass value="20"/>
            <inertia ixx="2.4" ixy="0" ixz="0" iyy="2.4" iyz="0" izz="3.5999999999999996"/>
        </inertial>
    </link>
<!-- Definition of the shape -->
 
    <link name="0">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder length="0.9" radius="0.2"/>
            </geometry>
            <material name="red">
                <color rgba="1 1 1 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.9" radius="0.2"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0"/> 
            <mass value="0.5"/>
            <inertia ixx="0.03875" ixy="0" ixz="0" iyy="0.03875" iyz="0" izz="0.010000000000000002"/>
        </inertial>
    </link>

    <joint name="0_joint" type="fixed">
        <parent link="base"/>
        <child link="0"/>
        <origin xyz="0 0 0.5" rpy="0 0 0"/>
    </joint>
 
    <link name="1">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder length="0.1" radius="0.6"/>
            </geometry>
            <material name="red">
                <color rgba="1 1 1 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.1" radius="0.6"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0"/> 
            <mass value="0.5"/>
            <inertia ixx="0.04541666666666667" ixy="0" ixz="0" iyy="0.04541666666666667" iyz="0" izz="0.09"/>
        </inertial>
    </link>

    <joint name="1_joint" type="fixed">
        <parent link="base"/>
        <child link="1"/>
        <origin xyz="0 0 1.0" rpy="0 0 0"/>
    </joint>

</robot>